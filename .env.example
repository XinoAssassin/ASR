# Backend
ASR_API_KEY=                      # optional shared key; empty disables auth
ASR_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ASR_UPLOAD_ROOTS=./data/uploads   # os.pathsep-separated list of allowed roots
ASR_DATA_DIR=./data
ASR_MODEL_CACHE_DIR=./models
ASR_DEVICE=cpu                    # cpu | cuda
ASR_PROVIDER_DEFAULT=cloud        # cloud | local (local arrives with M5)

# Cloud provider (Alibaba DashScope)
DASHSCOPE_API_KEY=
DASHSCOPE_ENDPOINT=https://dashscope.aliyuncs.com
ASR_CLOUD_MODEL=qwen-audio-3.1-asr-flash-filetrans
ASR_CLOUD_FILE_TRANSFER=temp_upload   # temp_upload | oss | public_url
ASR_DECODER=pyav                      # pyav | imageio

# Frontend (docker only)
ASR_BACKEND_URL=http://localhost:8000
