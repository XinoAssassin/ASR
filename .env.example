# Backend
ASR_API_KEY=                      # shared X-API-Key; empty disables auth (loopback hosts only)
ASR_ALLOWED_HOSTS=                # extra Host names accepted while auth is disabled, comma-separated
ASR_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ASR_UPLOAD_ROOTS=./data/uploads   # os.pathsep-separated allowed roots; must not contain ASR_DATA_DIR
ASR_DATA_DIR=./data
ASR_MODEL_CACHE_DIR=./models
ASR_DEVICE=cpu                    # cpu | cuda
ASR_PROVIDER_DEFAULT=cloud        # cloud | local (local arrives with M5)

# Cloud provider (Alibaba DashScope)
DASHSCOPE_API_KEY=
DASHSCOPE_ENDPOINT=https://dashscope.aliyuncs.com
ASR_CLOUD_MODEL=qwen-audio-3.1-asr-flash-filetrans
ASR_CLOUD_FILE_TRANSFER=temp_upload   # temp_upload | public_url (oss not implemented yet)
ASR_DECODER=pyav                      # pyav | imageio

# Docker
ASR_BIND_ADDR=127.0.0.1             # host address for published ports; 0.0.0.0 needs ASR_API_KEY
# Frontend (docker only)
ASR_BACKEND_URL=http://localhost:8000
