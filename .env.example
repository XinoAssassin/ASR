# Copy to .env (repo root) or backend/.env. Real environment variables win over both files.
# `asr serve` reads these files; the other CLI commands (`asr models`, `asr batch`, `asr transcribe`)
# read the process environment only. Full reference: docs/DEPLOYMENT.md.
# Values are unquoted; an inline comment needs a space before the '#'. systemd's EnvironmentFile
# does not understand inline comments: keep comments on their own lines there.

# Backend: access
ASR_API_KEY=                      # shared X-API-Key; empty disables auth (loopback clients only)
ASR_ALLOWED_HOSTS=                # extra Host names accepted while auth is disabled, comma-separated
# Auth off = loopback clients only, and `asr serve` refuses a non-loopback --host. Set to 1 ONLY when
# the port is published on loopback alone (docker-compose.yml sets it for its 127.0.0.1 publish).
ASR_ALLOW_UNAUTHENTICATED_NETWORK=
ASR_CORS_ORIGINS=http://localhost:5173,http://localhost:8080   # SPA origins, comma-separated, no '*'; desktop app: http://tauri.localhost

# Backend: storage and models (relative paths resolve against the working directory)
ASR_DATA_DIR=./data               # asr.db, upload sessions
ASR_UPLOAD_ROOTS=./data/uploads   # os.pathsep-separated (':' Linux, ';' Windows); must not contain ASR_DATA_DIR
ASR_MODEL_CACHE_DIR=./models      # local model weights; filled only by `asr models download` / Settings

# Backend: processing
ASR_PROVIDER_DEFAULT=cloud        # cloud | local
ASR_DEVICE=cpu                    # cpu | cuda | rocm (AMD GPU; needs the rocm extra / backend-rocm image)
ASR_DECODER=pyav                  # pyav | imageio (bundled ffmpeg either way)
# The next two are read from the real process environment only (a value in .env is ignored):
# export them, or set them in the systemd unit / compose file.
ASR_TORCH_THREADS=                # CPU inference threads; empty = min(16, CPU count)
ASR_LOCAL_DTYPE=                  # auto | float32 | bfloat16 | float16; empty = auto (bf16 where native, else fp16 on CUDA, fp32 on CPU)

# Backend: logging
ASR_LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
ASR_LOG_FORMAT=text               # text | json (one object per line; job lines carry job_id)
ASR_LOG_FILE=                     # optional file, rotated at 10 MB x 5; stdout/stderr is always logged

# Online settings (cloud ASR + LLM). Precedence: Settings page > config file > these variables.
# The config file (TOML, deploy/config.example.toml) is the preferred place for keys; chmod 600.
ASR_CONFIG_FILE=                  # empty = <ASR_DATA_DIR>/config.toml if it exists

# Cloud provider (Alibaba DashScope); the key never leaves the backend
DASHSCOPE_API_KEY=
DASHSCOPE_ENDPOINT=https://dashscope.aliyuncs.com
ASR_CLOUD_MODEL=qwen-audio-3.1-asr-flash-filetrans
ASR_CLOUD_FILE_TRANSFER=temp_upload   # temp_upload | public_url (oss not implemented yet)

# LLM for summaries and correction suggestions
ASR_LLM_PROVIDER=                 # dashscope (default) | openai (any OpenAI-compatible server; the text goes there)
ASR_LLM_ENDPOINT=                 # dashscope: empty = DASHSCOPE_ENDPOINT; openai: base URL incl. /v1, e.g. http://192.168.2.10:8080/v1
ASR_LLM_MODEL=qwen-plus           # chat model
ASR_LLM_API_KEY=                  # dashscope: empty = DASHSCOPE_API_KEY; openai: optional

# Docker only (docker-compose.yml)
ASR_BIND_ADDR=127.0.0.1           # host address for published ports; 0.0.0.0 needs ASR_API_KEY
ASR_BACKEND_PORT=8000             # host port of the backend container
ASR_FRONTEND_PORT=8080            # host port of the frontend container
ASR_BACKEND_URL=http://localhost:8000   # backend URL as the browser sees it, rendered into /config.js
ASR_RENDER_GID=                   # docker-compose.rocm.yml only: host gid of `render` (getent group render | cut -d: -f3)
