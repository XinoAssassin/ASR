{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ASR Recorder",
  "version": "0.1.0",
  "identifier": "dev.asr.recorder",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../frontend dev",
    "beforeBuildCommand": "pnpm --dir ../frontend build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "ASR Recorder",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https: http:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "ASR Recorder contributors",
    "copyright": "Copyright (c) 2026 ASR Recorder contributors",
    "category": "Productivity",
    "shortDescription": "Records system audio and microphone and sends them to the ASR backend",
    "longDescription": "ASR Recorder captures what you hear (WASAPI loopback, optionally one application only) plus the microphone into a 2-channel 16 kHz FLAC and uploads it to a self-hosted ASR backend for speaker-labelled transcription.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "ASR Recorder"
      }
    }
  }
}
