<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements of the macOS app (hardened runtime, Developer ID / ad-hoc; no App Sandbox).
  * device.audio-input: the hardened runtime blocks the microphone without it.
  Not needed, deliberately absent:
  * Screen Recording (ScreenCaptureKit system audio) is a TCC permission, not an entitlement.
  * network.client / files.*: App Sandbox entitlements; the app is not sandboxed.
  * cs.allow-jit / allow-unsigned-executable-memory: WKWebView's JIT runs in WebKit's own
    processes, not in ours.
  * cs.disable-library-validation: the managed backend (Python, torch and their unsigned
    extension modules) runs as a separate child process (uv-managed python), never inside
    this process, and entitlements do not propagate to child processes.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
